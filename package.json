{
  "name": "seat-reservation-service",
  "version": "1.0.0",
  "description": "Seat reservation at scale: no double-sell, per-user limits, idempotent retries.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "burst": "tsx scripts/burst.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "undici": "^8.11.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "mysql2": "^3.24.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "ulid": "^3.0.2",
    "zod": "^4.6.5"
  }
}
