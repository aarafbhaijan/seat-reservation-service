# Copy to .env and change for any non-local deployment. docker compose reads .env automatically.
MYSQL_PASSWORD=app-password
MYSQL_ROOT_PASSWORD=root-password
# 32+ random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789
# Needed to mint admin tokens (create shows) and to run the burst script
ADMIN_API_KEY=local-dev-admin-key
DB_POOL_SIZE=20
LOG_LEVEL=info
APP_PORT=3000
MYSQL_HOST_PORT=3306
